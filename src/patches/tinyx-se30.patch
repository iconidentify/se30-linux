+/*
+ * evdev mouse: read the kernel's input events directly. Used for the
+ * Macintosh ADB mouse, where /dev/input/mice's PS/2 emulation and this
+ * driver's protocol probing don't get along.
+ */
+static void EvdevRead(int fd, void *closure)
+{
+	KdMouseInfo *mi = closure;
+	static unsigned long buttons;
+	static int dx, dy;
+	struct input_event ev[16];
+	int n, i;
+
+	while ((n = read(fd, ev, sizeof(ev))) > 0) {
+		for (i = 0; i < n / (int)sizeof(ev[0]); i++) {
+			unsigned long b = 0;
+
+			switch (ev[i].type) {
+			case EV_REL:
+				if (ev[i].code == REL_X)
+					dx += ev[i].value;
+				else if (ev[i].code == REL_Y)
+					dy += ev[i].value;
+				break;
+			case EV_KEY:
+				if (ev[i].code == BTN_LEFT)
+					b = KD_BUTTON_1;
+				else if (ev[i].code == BTN_MIDDLE)
+					b = KD_BUTTON_2;
+				else if (ev[i].code == BTN_RIGHT)
+					b = KD_BUTTON_3;
+				if (ev[i].value)
+					buttons |= b;
+				else
+					buttons &= ~b;
+				break;
+			case EV_SYN:
+				KdEnqueueMouseEvent(mi, buttons | KD_MOUSE_DELTA, dx, dy);
+				dx = dy = 0;
+				break;
+			}
+		}
+	}
+}
