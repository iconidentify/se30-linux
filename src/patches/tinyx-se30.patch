+/* Find the first evdev device that reports relative motion. */
+static char *EvdevFindMouse(void)
+{
+	char path[32];
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		unsigned long evbits = 0;
+		int fd;
+
+		snprintf(path, sizeof(path), "/dev/input/event%d", i);
+		fd = open(path, O_RDONLY);
+		if (fd < 0)
+			continue;
+		ioctl(fd, EVIOCGBIT(0, sizeof(evbits)), &evbits);
+		close(fd);
+		if (evbits & (1UL << EV_REL))
+			return strdup(path);
+	}
+	return NULL;
+}
