+/* Copy damaged areas of the 1 bpp shadow to a MONO01 screen, inverted. */
+static void fbdevUpdateInvert(ScreenPtr pScreen, shadowBufPtr pBuf)
+{
+	RegionPtr damage = shadowDamage(pBuf);
+	PixmapPtr pShadow = pBuf->pPixmap;
+	int nbox = REGION_NUM_RECTS(damage);
+	BoxPtr pbox = REGION_RECTS(damage);
+	FbBits *shaBase;
+	FbStride shaStride;
+	int shaBpp, shaXoff _X_UNUSED, shaYoff _X_UNUSED;
+
+	fbGetDrawable(&pShadow->drawable, shaBase, shaStride, shaBpp, shaXoff,
+		      shaYoff);
+	for (; nbox--; pbox++) {
+		int x0 = pbox->x1 >> 3, x1 = (pbox->x2 + 7) >> 3, y, i;
+
+		for (y = pbox->y1; y < pbox->y2; y++) {
+			CARD8 *sha = (CARD8 *) (shaBase + y * shaStride) + x0;
+			CARD32 winSize;
+			CARD8 *win = (*pBuf->window) (pScreen, y, x0,
+						      SHADOW_WINDOW_WRITE,
+						      &winSize, pBuf->closure);
+
+			if (!win)
+				return;
+			for (i = 0; i < x1 - x0; i++)
+				win[i] = ~sha[i];
+		}
+	}
+}
